Section "ServerFlags"
  # Hotplug is on, but Xorg runs with -seat seat-brushye, so udev only offers devices the
  # maintainer's rule tagged for that seat (just the virtual pen). The InputClass sections below
  # ignore everything else as a second safeguard.
  Option "AutoAddGPU" "false"
  Option "DontVTSwitch" "true"
EndSection
Section "InputClass"
  Identifier "ignore everything"
  MatchDevicePath "*"
  Option "Ignore" "on"
EndSection
Section "InputClass"
  Identifier "Brushye Virtual Pen"
  MatchProduct "Brushye Virtual Pen"
  MatchDevicePath "/dev/input/event*"
  Driver "libinput"
  Option "Ignore" "off"
EndSection
Section "Device"
  Identifier "dummy"
  Driver "dummy"
  VideoRam 256000
EndSection
Section "Monitor"
  Identifier "mon"
  HorizSync 5.0-1000.0
  VertRefresh 5.0-200.0
  Modeline "1920x1080" 148.50 1920 2008 2052 2200 1080 1084 1089 1125 +hsync +vsync
EndSection
Section "Screen"
  Identifier "scr"
  Device "dummy"
  Monitor "mon"
  DefaultDepth 24
  SubSection "Display"
    Depth 24
    Modes "1920x1080"
    Virtual 1920 1080
  EndSubSection
EndSection
Section "ServerLayout"
  Identifier "layout"
  Screen "scr"
EndSection
